# Veridex backend model configuration

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional: enable OpenRouter as a normal fallback provider
VERIDEX_MODEL_ALLOW_OPENROUTER=false

# Optional: Google Programmable Search / Custom Search JSON API.
# When a search engine ID is set, Veridex uses Google for general web/review searches and falls back to DuckDuckGo if Google fails.
# GOOGLE_SEARCH_API_KEY is optional if GEMINI_API_KEY is a Google API key with Custom Search enabled.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional: SerpAPI Google Search API.
# When set, Veridex uses SerpAPI first for general web/review searches, then Google Custom Search, then DuckDuckGo.
SERPAPI_API_KEY=

# Per-user Google Gmail and Calendar integration. The OAuth callback must be
# registered in Google Cloud and point at the backend callback endpoint.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8078/integrations/google/callback
# Use a unique, high-entropy value of at least 32 characters. Do not reuse an API key.
VERIDEX_INTEGRATION_ENCRYPTION_KEY=
# Frontend destination after the backend completes the OAuth callback.
VERIDEX_INTEGRATIONS_SUCCESS_URL=https://localhost:3078/profile?google=connected
