# Veridex backend model configuration

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional: enable OpenRouter as a normal fallback provider
VERIDEX_MODEL_ALLOW_OPENROUTER=false
# Keep API-backed Gemini/Groq fallback disabled unless you explicitly want it.
VERIDEX_MODEL_ALLOW_EXTERNAL_FALLBACK=false

# Primary AI chat provider: the locally authenticated Codex CLI. This uses the
# user's Codex/ChatGPT sign-in and does not require an OpenAI API key.
VERIDEX_CODEX_ENABLED=true
VERIDEX_CODEX_GATEWAY=C:\codex2veridex\codex_gateway.py
VERIDEX_CODEX_WORKDIR=C:\Office-App
VERIDEX_CODEX_TIMEOUT_SECONDS=240
VERIDEX_CODEX_PROVIDER_TIMEOUT_SECONDS=255

# Local testing mode: bypass login/onboarding and restore one stable account.
# Workspaces, sessions, files, artifacts, and chat transcripts remain separate
# beneath that account's governed session ownership.
VERIDEX_SINGLE_USER_MODE=true

# Optional local Codex MCP integration token. When set, /tools, /call, and
# /request require this token from the local bridge. Never commit the value.
VERIDEX_CODEX_TOKEN=

# Optional: Google Programmable Search / Custom Search JSON API.
# When a search engine ID is set, Veridex uses Google for general web/review searches and falls back to DuckDuckGo if Google fails.
# GOOGLE_SEARCH_API_KEY is optional if GEMINI_API_KEY is a Google API key with Custom Search enabled.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional: SerpAPI Google Search API.
# When set, Veridex uses SerpAPI first for general web/review searches, then Google Custom Search, then DuckDuckGo.
SERPAPI_API_KEY=

# Per-user Google Gmail and Calendar integration. The OAuth callback must be
# registered in Google Cloud and point at the backend callback endpoint.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8078/integrations/google/callback
# Use a unique, high-entropy value of at least 32 characters. Do not reuse an API key.
VERIDEX_INTEGRATION_ENCRYPTION_KEY=
# Frontend destination after the backend completes the OAuth callback.
VERIDEX_INTEGRATIONS_SUCCESS_URL=https://localhost:3000/profile?google=connected
